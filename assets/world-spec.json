 "knowledge_model": {
  "stores": "each resident: {sign_links: {sign_id->resource_id: confidence}, resources: {resource_id: state}, concepts: {concept_id: confidence}, places: [{x,y,resource_id,confidence}]}",
  "resource_states": [
   "unknown",
   "noticed",
   "hypothesis",
   "confirmed",
   "mastered"
  ],
  "thresholds": {
   "hypothesis": 0.2,
   "confirmed": 0.6,
   "mastered": 0.9
  },
  "notice_chance_per_day": "resource.discovery.base_notice * (0.5 + race.perception[resource.category]) * (0.5 + trait.curiosity) * visibility_now(sign) * (1 - sign.notice_difficulty)",
  "on_notice": "add sign_link(sign,resource) with confidence 0.15; remember place",
  "on_test_dig_success": "+0.25 confidence (×1.5 if dig was chosen because of the sign)",
  "on_test_dig_failure": "-0.10 confidence; false positives create superstitions when confidence stays 0.2..0.5 for 30+ days",
  "decay_per_day": 0.001,
  "teach": {
   "per_day_together": 0.05,
   "parent_to_child_at_age": 12,
   "mentor_bonus": "skill/100"
  },
  "lost_if_no_holders": true,
  "superstition": {
   "created_from": "false sign_links",
   "spread_like_knowledge": true,
   "affects": "where residents choose to dig"
  }
 },
