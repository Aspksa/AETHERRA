{
 "meta": {
  "id": "aetherra-world-spec",
  "version": "0.1.0",
  "language_names": "ru",
  "purpose": "Data for AETHERRA: geology, resources (real + fantastic), signs, discovery, prospecting, extraction, tools, races, knowledge, conflict. No LLM, no player input: all behaviour comes from these rules.",
  "path_in_repo": "assets/world-spec.json",
  "units": {
   "depth": "layer index 0..4 (0 = surface, 4 = deepest)",
   "hardness": "1..10, time to extract one unit scales with hardness / tool.power",
   "rarity": "0..1, share of eligible cells that receive a deposit",
   "chance": "probability per resident-day unless stated otherwise",
   "confidence": "0..1, belief strength inside one resident's knowledge",
   "time": "game days (1 day = 1 / 0.065 ticks)"
  },
  "conventions": [
   "ids are snake_case and never renamed; add new entries instead",
   "every reference (biome, rock, sign, resource, tool, race, method, action) must exist in this file",
   "fantastic = true marks resources that do not exist in the real world",
   "nothing is known at world start: residents begin with only knowledge listed in races[].starting_knowledge"
  ]
 },
